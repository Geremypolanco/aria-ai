# Lingua — standalone app config. Copy to .env in this directory.

# Hugging Face token — powers exercise generation, images, TTS, and STT.
# Get one at https://huggingface.co/settings/tokens (read access is enough for
# the serverless Inference API / Inference Providers used here).
# Without it, the app still runs in a degraded "demo mode": lessons use
# template placeholder content and no audio/image/voice features work.
HF_TOKEN=

# Optional overrides — sensible defaults are baked in.
# LINGUA_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
# LINGUA_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# LINGUA_STT_MODEL=openai/whisper-large-v3
# LINGUA_TTS_MODEL_PREFIX=facebook/mms-tts
# LINGUA_DB_PATH=./data/lingua.db
# LINGUA_CACHE_DIR=./data/media_cache
# LINGUA_HOST=0.0.0.0
# LINGUA_PORT=8100
