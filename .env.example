# ARIA AI — Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every variable below maps 1:1 to apps/core/config.py (pydantic BaseSettings).
# Nothing is hardcoded in the source — all secrets come from the environment.
#
# Legend:
#   [REQUIRED]  the app cannot do its core job without this in production
#   (optional)  only needed if you use that integration/feature
# Values shown are placeholders or safe dev defaults — never real secrets.

# ── Runtime ───────────────────────────────────────────────
ENVIRONMENT=development
PORT=8080
# Public base URL of this deployment (callbacks, OAuth redirects, bot links).
ARIA_BASE_URL=https://aria-ai.fly.dev
# Autonomous cycle cadence.
CYCLE_INTERVAL_MINUTES=60

# ── Owner / identity ──────────────────────────────────────
OWNER_NAME=Geremy Polanco
# [REQUIRED] used for owner-only gates and notifications.
OWNER_EMAIL=you@example.com

# ── Safety / approvals ────────────────────────────────────
REQUIRE_APPROVAL_FOR_PAYMENTS=true
REQUIRE_APPROVAL_FOR_DEPLOYS=false
MAX_SPEND_WITHOUT_APPROVAL_USD=0
ALLOW_SYSTEM_COMMANDS=false
GUARDRAILS_ENABLED=true

# ── Access control / secrets ──────────────────────────────
# Password gating the /admin control panel. [REQUIRED] in production —
# without it the admin panel stays locked.
ADMIN_PASSWORD=
# Dedicated HMAC key for signing user session cookies + OAuth state.
# [REQUIRED] in production — without it, sessions use an ephemeral
# per-process key (they won't survive restarts or span instances).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Optional public API key for programmatic access.
ARIA_API_KEY=
# Key for encrypting stored connector credentials at rest.
CONNECTOR_ENC_KEY=
# Secret for signing outbound integration webhooks.
WEBHOOK_SECRET=
# Fly.io API token — powers the live instance counter in /admin (optional).
FLY_API_TOKEN=
FLY_APP_NAME=aria-ai

# ── Datastores ────────────────────────────────────────────
# [REQUIRED] Supabase (Postgres) — memory, agents, tasks, billing state.
# Apply database/*.sql + supabase_schema.sql to the project first.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Redis — pick ONE. Upstash REST for serverless/hosted, REDIS_URL for
# docker-compose local (redis://redis:6379) or any Redis server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=

# ── AI providers ──────────────────────────────────────────
# [REQUIRED] at least ONE LLM provider — HuggingFace is the primary engine.
HF_TOKEN=
HF_API_KEY=
HUGGING_FACE_TOKEN=
# Model routing (sane defaults; override to pin models).
HF_MODEL_STRATEGY=Qwen/Qwen2.5-72B-Instruct
HF_MODEL_CODE=Qwen/Qwen2.5-Coder-7B-Instruct
HF_MODEL_FAST=microsoft/Phi-3-mini-4k-instruct
HF_MODEL_CREATIVE=HuggingFaceH4/zephyr-7b-beta
# Fallback models used when the primary tier fails.
HF_MODEL_STRATEGY_FB=mistralai/Mistral-7B-Instruct-v0.3
HF_MODEL_CODE_FB=microsoft/Phi-3.5-mini-instruct
HF_MODEL_FAST_FB=google/flan-t5-large
# Groq (fast fallback) — optional.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_CODE=llama-3.3-70b-versatile
# Anthropic / OpenAI / Google / Cohere — optional fallbacks.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
COHERE_API_KEY=
# Video generation (optional).
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=lightricks/ltx-video
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/ltx-video

# ── Web research providers (optional) ─────────────────────
NEWS_API_KEY=
SERP_API_KEY=
TAVILY_API_KEY=
